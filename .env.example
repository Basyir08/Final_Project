# Salin menjadi .env lalu sesuaikan.

# ---------- aplikasi ----------
DEBUG=false
CORS_ORIGINS=http://localhost:8501

# ---------- bobot & riwayat training ----------
YOLO_WEIGHTS=models/YOLO_best.pt
FRCNN_WEIGHTS=models/best_frcnn.pt
YOLO_HISTORY=models/YOLO_history.csv
FRCNN_HISTORY=models/FRCNN_history.csv

# muat kedua model saat startup (false = lazy saat request pertama)
PRELOAD_MODELS=false
DEVICE=auto          # auto | cpu | cuda

# ---------- preprocessing (HARUS sama dengan saat training) ----------
IMG_SIZE=832
CLAHE_CLIP=2.0
CLAHE_TILE=8
APPLY_LIGHT_DENOISE=false

# ---------- inferensi ----------
DEFAULT_CONF=0.25
MAX_UPLOAD_MB=20

# ---------- database ----------
# SQLite (default, langsung jalan)
DATABASE_URL=sqlite:///./data/predictions.db
# PostgreSQL
# DATABASE_URL=postgresql+psycopg://fracture:fracture@db:5432/fracture

# ---------- Streamlit ----------
API_BASE_URL=http://localhost:8000
